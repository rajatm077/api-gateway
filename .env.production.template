# =================================
# API Gateway Production Environment Configuration
# =================================
# IMPORTANT: Replace all placeholder values with actual production values

# Server Configuration
NODE_ENV=production
PORT=3000
SERVICE_NAME=api-gateway

# =================================
# JWT Configuration
# =================================
# CRITICAL: Replace with your actual production JWT public key
JWT_PUBLIC_KEY="REPLACE_WITH_YOUR_ACTUAL_JWT_PUBLIC_KEY"
JWT_ALGORITHM=RS256
JWT_ISSUER=your-production-issuer

# =================================
# Redis Configuration
# =================================
# Use your production Redis instance
REDIS_URL=redis://production-redis:6379
REDIS_DB=0
REDIS_KEY_PREFIX=api-gateway:prod:

# =================================
# Kafka Configuration
# =================================
# Use your production Kafka cluster
KAFKA_BROKERS=production-kafka-1:9092,production-kafka-2:9092,production-kafka-3:9092
KAFKA_CLIENT_ID=api-gateway-prod
KAFKA_SSL=true

# Production Kafka SASL configuration
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_SASL_USERNAME=your-production-kafka-username
KAFKA_SASL_PASSWORD=your-production-kafka-password

# =================================
# Query Service Configuration
# =================================
# Use your production Query Service
QUERY_SERVICE_URL=https://query-service.your-domain.com
QUERY_SERVICE_TIMEOUT=10000
QUERY_SERVICE_RETRIES=3

# =================================
# Rate Limiting Configuration
# =================================
RATE_LIMIT_DEFAULT=1000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_BURST=2000

# =================================
# Service Registry Configuration
# =================================
SERVICE_REGISTRY_URL=https://consul.your-domain.com
SERVICE_REGISTRY_HEARTBEAT_INTERVAL=30000

# =================================
# Webhook Secrets
# =================================
TWILIO_WEBHOOK_SECRET=your-production-twilio-webhook-secret
SENDGRID_WEBHOOK_SECRET=your-production-sendgrid-webhook-secret
WHATSAPP_WEBHOOK_SECRET=your-production-whatsapp-webhook-secret

# =================================
# Logging Configuration
# =================================
LOG_LEVEL=warn
LOG_FORMAT=json

# =================================
# Monitoring Configuration
# =================================
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000

# =================================
# Security Configuration
# =================================
# ENABLE_REQUEST_LOGGING=false
# TRUST_PROXY=true

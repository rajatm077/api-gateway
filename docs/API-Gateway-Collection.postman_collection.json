{
  "info": {
    "name": "API Gateway Collection",
    "description": "Complete collection for the API Gateway with all endpoints, headers, and request bodies",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3002",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ0ZXN0LXVzZXIiLCJ0ZW5hbnRJZCI6InRlc3QtdGVuYW50IiwiaWF0IjoxNjkzNDg4MDAwLCJleHAiOjk5OTk5OTk5OTl9.test-signature",
      "type": "string",
